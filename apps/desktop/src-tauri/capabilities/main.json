{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workspace",
  "description": "Only the local main window may edit placements, control terminals and receive quit events.",
  "windows": ["main"],
  "permissions": ["allow-get-layout-snapshot", "allow-add-placeholder", "allow-remove-placement", "allow-place-block", "allow-terminal-command", "allow-get-text-block", "core:event:allow-listen", "core:event:allow-unlisten"]
}
